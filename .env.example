# ─── Postgres ───────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=auto_tracker
DB_USER=auto_tracker
DB_PASSWORD=auto_tracker

# ─── Mail (Mailhog dev SMTP, test mode) ─────────────────────
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=auto-tracker@localhost

# ─── Scraper ────────────────────────────────────────────────
SCRAPE_BASE_URL=https://olx.ba/vozila
SCRAPE_DELAY_MS=2000
SCRAPE_CRON=0 0 */2 * * *      # every 2 hours

# ─── Digest email ───────────────────────────────────────────
DIGEST_CRON=0 7 * * *          # daily 07:00

# ─── Fair-price scoring ─────────────────────────────────────
SCORE_YEAR_TOLERANCE=2         # cohort = same model, year ± this
SCORE_UNDERPRICED_PCT=10       # flag listings >= this % below cohort avg
